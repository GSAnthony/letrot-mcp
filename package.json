{
  "name": "letrot-mcp",
  "version": "1.0.0",
  "description": "Letrot MCP App - Display French harness racing meetings and partants",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "cross-env INPUT=mcp-app.html vite build && tsc -p tsconfig.server.json && node scripts/copy-mocks.mjs",
    "watch": "cross-env INPUT=mcp-app.html vite build --watch",
    "serve": "tsx --env-file-if-exists=.env --watch main.ts",
    "dev": "cross-env NODE_ENV=development concurrently \"npm run watch\" \"npm run serve\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
